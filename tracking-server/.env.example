# Guardian tracking server — copy to .env and adjust.

PORT=4000

# "production" enforces HTTPS (redirects GET, rejects other methods over HTTP).
NODE_ENV=development

# Optional. Leave empty to keep sessions in memory (single instance; lost on
# restart, which is fine for short-lived live shares). Set a MongoDB URI to
# persist sessions and run several instances.
MONGO_URI=
# MONGO_URI=mongodb://localhost:27017/guardian_tracking

# Public base URL used in the links sent to contacts, e.g. https://track.example.org
# When empty, links use the host the phone connected to.
PUBLIC_URL=

# Number of reverse-proxy hops to trust for X-Forwarded-* (1 behind a load
# balancer / Render / Railway / Fly; 0 when exposed directly).
TRUST_PROXY_HOPS=0
